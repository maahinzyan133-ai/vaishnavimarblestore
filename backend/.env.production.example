# ==========================================
# Hostinger Production Server Configuration
# Set these values in Hostinger hPanel; do not upload this file as .env.
# ==========================================
PORT=4000
NODE_ENV=production
CLIENT_ORIGIN=https://vaishnavimarble.com,https://www.vaishnavimarble.com,https://peru-sardine-984649.hostingersite.com

# ==========================================
# Hostinger MySQL Database Configuration
# Use the exact values shown in hPanel -> Databases -> MySQL Databases.
# ==========================================
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=your_database_user
DB_PASSWORD=replace_with_generated_database_password
DB_NAME=your_database_name
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true

# Apply backend/sql/schema.sql safely at API startup (CREATE TABLE IF NOT EXISTS).
AUTO_MIGRATE=true

# ==========================================
# Authentication & Security
# Generate new random secrets; do not reuse values shared in chat.
# JWT_SECRET must contain at least 32 characters.
# Use the admin values once with `npm run seed`, then remove ADMIN_PASSWORD.
# ==========================================
JWT_SECRET=generate_a_unique_secret_at_least_32_characters_long
JWT_EXPIRES_IN=7d
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace_with_a_unique_strong_password
